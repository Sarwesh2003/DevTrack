{
  "$schema": "https://tauri.app/schema/config",
  "productName": "DevTrack",
  "version": "0.1.0",
  "identifier": "com.devtrack.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DevTrack",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  },
  "plugins": {
    "dialog": {
      "defaultOpenFilters": [
        {
          "name": "SQLite database",
          "extensions": ["sqlite"]
        }
      ]
    },
    "fs": {
      "scope": [
        "$APP/*",
        "$DOCUMENTS/DevTrack/*"
      ]
    }
  }
}
